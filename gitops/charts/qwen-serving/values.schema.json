{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicas", "image", "downloaderImage", "model", "resources"],
  "properties": {
    "replicas": {"type": "integer", "minimum": 0, "maximum": 1},
    "image": {"type": "string", "pattern": "^[a-z0-9./:_-]+@sha256:[a-f0-9]{64}$"},
    "downloaderImage": {"type": "string", "pattern": "^[a-z0-9./:_-]+@sha256:[a-f0-9]{64}$"}
  }
}
